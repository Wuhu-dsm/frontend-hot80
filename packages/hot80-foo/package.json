{
  "name": "@wuhu-dsm/hot80-foo",
  "version": "0.0.4",
  "description": "POC publishable package foo for frontend-hot80 release pipeline",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
