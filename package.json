{
  "name": "frontend-hot80",
  "version": "1.0.0",
  "private": true,
  "description": "前端面试手写题 HOT80 练习项目",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:js": "vitest run problems/01-async problems/02-data-structure problems/03-array-object problems/04-utils",
    "test:react": "vitest run problems/05-react-components problems/06-react-hooks",
    "test:problem": "vitest run",
    "dev:css": "vite --config vite.css.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.8"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
